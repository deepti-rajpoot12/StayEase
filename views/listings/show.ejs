<% layout("/layouts/boilerplate") %>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<main class="listing-detail-page py-4 py-lg-5">
  <div class="row g-4 g-lg-5">
    <section class="col-lg-8">
      <header class="listing-detail-header">
        <p class="listing-category"><%= listing.category %></p>
        <h1><%= listing.title %></h1>
        <p class="listing-detail-location">
          <i class="fa-solid fa-location-dot"></i>
          <%= listing.location %>, <%= listing.country %>
        </p>
      </header>

      <img
        class="listing-detail-image"
        src="<%= listing.image.url %>"
        alt="<%= listing.title %>"
      >

      <section class="listing-overview-card">
        <div class="listing-owner">
          <div class="listing-owner-icon"><i class="fa-solid fa-house"></i></div>
          <div>
            <span>Hosted by</span>
            <strong><%= listing.owner.role === "admin" ? "StayEase" : listing.owner.username %></strong>
          </div>
          <strong class="listing-price">₹<%= listing.price.toLocaleString("en-IN") %><small> / night</small></strong>
        </div>
        <p class="listing-description"><%= listing.description %></p>
      </section>

      <% if(isAdmin) { %>
        <div class="listing-owner-actions">
          <span>You own this listing</span>
          <div>
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark btn-sm">Edit listing</a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
              <button class="btn btn-outline-danger btn-sm">Delete</button>
            </form>
          </div>
        </div>
      <% } %>

      <section class="listing-section review-section" id="reviews">
        <div class="listing-section-heading">
          <div>
            <p class="section-kicker">Guest feedback</p>
            <h2>Reviews</h2>
          </div>
          <span class="review-count"><%= listing.reviews.length %> review<%= listing.reviews.length === 1 ? "" : "s" %></span>
        </div>

        <% if(currUser && !isAdmin) { %>
          <div class="review-form-card">
            <h3>Leave a review</h3>
            <form action="/listings/<%= listing.id %>/reviews" method="post" novalidate class="needs-validation">
              <div class="mb-3">
                <label for="review[rating]" class="form-label">Your rating</label>
                <fieldset class="starability-slot">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating.">
                  <input type="radio" id="first-rate1" name="review[rating]" value="1">
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2">
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3">
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4">
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5">
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>

              <div class="mb-3">
                <label for="comment" class="form-label">Your comments</label>
                <textarea name="review[comment]" id="comment" rows="4" class="form-control" required></textarea>
                <div class="invalid-feedback">Please add comments for your review.</div>
              </div>
              <button class="btn btn-danger">Submit review</button>
            </form>
          </div>
        <% } else if (!currUser) { %>
          <p class="review-login-note"><a href="/login">Log in</a> to leave a review.</p>
        <% } %>

        <% if(listing.reviews.length > 0) { %>
          <div class="review-grid">
            <% for(review of listing.reviews) { %>
              <article class="review-card">
                <div class="review-card-header">
                  <div class="review-avatar"><%= review.author.username.charAt(0).toUpperCase() %></div>
                  <div>
                    <h3><%= review.author.username %></h3>
                    <p class="starability-result" data-rating="<%= review.rating %>"></p>
                  </div>
                </div>
                <p class="review-comment"><%= review.comment %></p>
                <% if(currUser && !isAdmin && review.author._id.equals(currUser._id)) { %>
                  <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                    <button class="review-delete-btn">Delete review</button>
                  </form>
                <% } %>
              </article>
            <% } %>
          </div>
        <% } else { %>
          <p class="review-empty">No reviews yet. Be the first to share your experience.</p>
        <% } %>
      </section>
    </section>

    <aside class="col-lg-4">
      <div class="listing-sidebar">
        <section class="reserve-card">
          <p class="section-kicker">Ready to stay?</p>
          <h2>Reserve this stay</h2>
          <p class="reserve-price">₹<%= listing.price.toLocaleString("en-IN") %> <span>/ night</span></p>
          <p class="reserve-copy">Choose your dates, then pay securely with Razorpay.</p>
          <% if (!isAdmin) { %>
            <a href="/bookings/<%= listing._id %>/new" class="btn btn-danger w-100 reserve-btn">Reserve now</a>
          <% } else { %>
            <a href="/admin/dashboard" class="btn btn-outline-dark w-100 reserve-btn">Back to listing management</a>
          <% } %>
        </section>

        <section class="map-card">
          <div class="map-card-heading">
            <i class="fa-solid fa-map-location-dot"></i>
            <div>
              <h2>Where you'll be</h2>
              <p><%= listing.location %>, <%= listing.country %></p>
            </div>
          </div>
          <div id="map"></div>
        </section>
      </div>
    </aside>
  </div>
</main>

<script src="/js/map.js"></script>
