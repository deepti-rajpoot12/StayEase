<% layout("/layouts/boilerplate") %>
<div class="row mt-5 mb-5">
  <div class="col-md-6 offset-md-3 col-lg-4 offset-lg-4">
    <h1>Create administrator account</h1>
    <p>Administrator registration requires the private invitation key configured by the site operator.</p>
    <% if (!process.env.ADMIN_SIGNUP_KEY) { %>
      <div class="alert alert-warning">Administrator registration is not configured. Set ADMIN_SIGNUP_KEY on the server first.</div>
    <% } %>
    <form action="/admin/signup" method="POST">
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input name="username" id="username" class="form-control" autocomplete="username" required>
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input name="email" id="email" type="email" class="form-control" autocomplete="email" required>
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input name="password" id="password" type="password" class="form-control" autocomplete="new-password" required>
      </div>
      <div class="mb-3">
        <label for="signupKey" class="form-label">Administrator invitation key</label>
        <input name="signupKey" id="signupKey" type="password" class="form-control" autocomplete="off" required>
      </div>
      <button class="btn btn-dark">Create administrator account</button>
    </form>
  </div>
</div>
