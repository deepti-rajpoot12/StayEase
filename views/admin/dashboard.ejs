<% layout("/layouts/boilerplate") %>
<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
  <div>
    <p class="text-uppercase text-muted mb-1">StayEase administration</p>
    <h1>Manage listings</h1>
  </div>
  <a class="btn btn-dark" href="/listings/new">Add listing</a>
</div>
<% if (listings.length) { %>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Listing</th><th>Location</th><th>Price / night</th><th>Actions</th></tr></thead>
      <tbody>
        <% listings.forEach((listing) => { %>
          <tr>
            <td><a href="/listings/<%= listing._id %>"><%= listing.title %></a></td>
            <td><%= listing.location %>, <%= listing.country %></td>
            <td>₹<%= listing.price.toLocaleString("en-IN") %></td>
            <td class="d-flex gap-2">
              <a class="btn btn-sm btn-outline-dark" href="/listings/<%= listing._id %>/edit">Edit</a>
              <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Delete this listing?')">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <p>No listings yet. Add the first StayEase listing.</p>
<% } %>
