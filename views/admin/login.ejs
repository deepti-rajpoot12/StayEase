<% layout("/layouts/boilerplate") %>
<div class="row mt-5 mb-5">
  <div class="col-md-6 offset-md-3 col-lg-4 offset-lg-4">
    <h1>Administrator login</h1>
    <p>Sign in with your StayEase administrator account.</p>
    <form action="/admin/login" method="POST">
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input name="username" id="username" class="form-control" autocomplete="username" required>
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input name="password" id="password" type="password" class="form-control" autocomplete="current-password" required>
      </div>
      <button class="btn btn-dark">Log in as administrator</button>
    </form>
    <p class="mt-3">Have an invitation key? <a href="/admin/signup">Create an administrator account</a>.</p>
  </div>
</div>
